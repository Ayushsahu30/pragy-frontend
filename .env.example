# Copy this file to ".env.local" and fill in the values.
# Never commit the real .env.local file.

# Address of the backend API (no slash at the end)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public address of this website (no slash at the end). Used for link previews.
# On Vercel this is https://acenshun.com. Setting it also sends visitors of the
# old pragy-frontend-zeta.vercel.app address to it (see next.config.ts).
NEXT_PUBLIC_SITE_URL=https://acenshun.com

# Where /api/... calls are forwarded (the backend). Defaults to NEXT_PUBLIC_API_URL.
API_PROXY_TARGET=http://localhost:4000
